# Copia in config/prossima.env sul server, poi: chmod 600 config/prossima.env
# Contiene il token del bot: non va mai nel repository.

# Il bot di Prossima volta (nuovo, separato da quelli dei selfie e di ctc), da @BotFather.
PV_BOT_TOKEN=

# L'identificativo del gruppo del party: un numero negativo
# (v. docs/messa-in-produzione.md, punto 3).
PV_GRUPPO=

PV_ROSTER=/config/roster.toml

# Le frasi di «Nessuna di queste» (v. config.esempio/frasi.txt). Senza questa
# riga il bot usa quelle predefinite.
PV_FRASI=/config/frasi.txt

# La domanda del sondaggio, al massimo 300 caratteri. Senza questa riga,
# «Prossima volta?». Con un # nella domanda, mettila fra virgolette.
# PV_DOMANDA=Prossima volta?

# I giorni di sempre di /sondaggio, separati da spazi. Senza questa riga, tutti
# tranne il sabato; chi lancia il sondaggio ne aggiunge uno con «con sabato».
# PV_GIORNI=lun mar mer gio ven dom

PV_DB=/data/prossima.sqlite
PV_BATTITO=/data/battito
PV_FUSO=Europe/Zurich

# Per il piano reale, a servizio fermo (v. docs/messa-in-produzione.md, punto 6):
# il tuo identificativo Telegram, a cui il piano reale scrive in privato.
# PV_REALE_CHAT=
